<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title><%= artist.name %></title>
    <link rel="stylesheet" href="/styles.css">
</head>
<body>
    <%- include('partials/navbar'); %>
    <h1 class="header"><%= artist.name %></h1>
    <h2><%= artist.city %></h2>


    <h2>Albums List</h2>
    <div class="listContainer">
        <% if(albums) { %>
            <ul class="albumsList">
                <% albums.forEach(album => { %>
                    <li class="albumCard">
                        <p>Album: <%= album.name %></p>
                    </li>
                <% }); %>
            </ul>
        <% } %>
    </div>
    <h2>Songs List</h2>
    <div class="listContainer">
        <% if(songs) { %>
            <ul class="songsList">
                <% songs.forEach(song => { %>
                    <li class="songCard">
                        <p>Song: <%= song.name %></p>
                    </li>
                <% }); %>
            </ul>
        <% } %>
    </div>

    <div>
        <form action="/artists/delete/<%= artist.id %>" method="POST">
            <button type="submit" onsubmit="return confirm('Are you sure you want to delete this artist?');">Delete This Artist</button>
        </form>
    </div>
</body>
</html>