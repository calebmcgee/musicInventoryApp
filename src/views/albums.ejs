<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title><%= title %></title>
    <link rel="stylesheet" href="/styles.css">
</head>
<body>
    <h1 class="header"><%= title %></h1>
    <%- include('partials/navbar'); %>

    <div id="albumContent">
        <!-- LIST OF EXISISTING ALBUMS-->
        <div class="listContainer">
            <h2>All Albums</h2>
            <ul>
                <% albums.forEach(album =>{ %>
                    <li class="albumCard">
                        <p><%= album.name %></p>
                        <p>Date Released: <%= album.date_released %></p>
                        <p>Artists :
                            <% album.artists.forEach((artist, index)=>{ %>
                                <%= artist %>
                                <% if(index != album.artists.length - 1){ %>
                                    ,
                                <% } %>
                            <% }) %>
                        </p>
                        <form action="/albums/delete/<%= album.id %>" method="POST">
                            <button>Delete This Album</button>
                        </form>
                    </li>
                <% }); %>
            </ul>
        </div>
        <!-- FORM FOR NEW ALBUMS -->
        <div id="albumFormContainer">
            <%- include('partials/errors'); %>
            <form action="/albums" method="POST">
                <div>
                    <label for="albumName">Album Name</label>
                    <input name="name" id="albumName" type="text" autocomplete="off">
                </div>
                <fieldset class="checkboxes">
                    <legend>Artists name</legend>
                    <% artists.forEach(artist => { %>
                        <div class="labelDiv">
                            <input type="checkbox" name="artistId" id="artist<%= artist.id %>" value="<%= artist.id %>">
                            <label for="artist<%= artist.id %>"><%= artist.name %></label>
                        </div>
                    <% }); %>
                </fieldset>
                <div>
                    <label for="date"></label>
                    <input type="date" name="dateReleased" id="date">
                </div>
                <button type="submit">Create new Album</button>
            </form>
        </div>
        
    </div>
</body>
</html>