<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title><%= title %></title>
    <link rel="stylesheet" href="/styles.css">
</head>
<body>
    <h1 class="header"><%= title %></h1>
    <%- include('partials/navbar'); %>
    <%- include('partials/errors') %>

    <div id="artistContent">
        <!-- DISPLAY ALL EXISTING ARTISTS-->
        <div class="listContainer">
            <h2>Artist List</h2>
            <% if(artists) { %>
                <ul class="list">
                    <% artists.forEach(artist => { %>
                        <li class="artistCard">
                            <p>Artist: <%= artist.name %></p>
                            <p>Area: <%= artist.city %></p>
                            <a href="/artists/<%= artist.id %>">View Info</a>
                            <form action="/artists/delete/<%= artist.id %>" method="POST">
                                <button type="submit" onsubmit="return confirm('Are you sure you want to delete this artist?');">Delete This Artist</button>
                            </form>
                        </li>
                    <% }); %>
                </ul>
            <% } %>
        </div>
        <!-- FORM FOR NEW ARTISTS-->
        <div>
            <form class="artistFormContainer" action="/artists" method="POST">
                <div class="labelDiv">
                    <label for="artistName">Artist</label>
                    <input name="name" id="artistName" type="text" autocomplete="off">
                </div>
                <div class="labelDiv">
                    <label for="artistCity">City</label>
                    <input name="city" id="artistCity" type="text" autocomplete="off">
                </div>
                <button type="submit">Create New Artist</button>
            </form>
        </div>
    <div>
        <form action="/artists/deleteAllArtists" method="POST">
            <button type="submit" onsubmit="return confirm('Are you sure you want to delete all artists?');">Delete All Artists</button>
        </form>
    </div>
    </div>

</body>
</html>